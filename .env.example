# Copy to .env for your backend or build step. The static front end reads its
# settings from "customers interface/assets/js/config.js" (generate that file
# from these values at deploy time).
API_BASE_URL=https://api.example.com/v1
APP_MODE=api
ASSET_BASE=https://cdn.example.com/marketlink/images/
MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
PAYSTACK_PUBLIC_KEY=
ERROR_REPORTING=false
